# Скопируйте в .env.local и подставьте значения из панели Supabase:
# Project Settings → API. Файл .env.local в .gitignore и в репозиторий не попадает.

# URL проекта, вида https://xxxxxxxxxxxx.supabase.co
# Префикс NEXT_PUBLIC_ означает, что значение попадает в клиентский бандл —
# для URL это нормально, он не секрет.
NEXT_PUBLIC_SUPABASE_URL=

# Ключ service_role. Обходит Row Level Security, поэтому используется ТОЛЬКО
# на сервере (route handlers, server actions). Никогда не добавляйте к нему
# префикс NEXT_PUBLIC_ и не импортируйте в клиентские компоненты.
SUPABASE_SERVICE_ROLE_KEY=
